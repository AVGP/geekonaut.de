---
layout: layouts/base.njk
---

<section class="pixel-window terminal-window" aria-label="Interactive Terminal">
  <div class="window-titlebar">
    <span class="window-title">geekonaut@zurich:~ (gsh 4.2)</span>
    <span class="window-controls" aria-hidden="true">
      <span class="win-dot">_</span>
      <span class="win-dot">□</span>
      <span class="win-dot">×</span>
    </span>
  </div>

  <div id="terminal-app" class="terminal-shell">
    <div id="terminal-viewport" class="terminal-viewport" aria-live="polite" aria-atomic="false">
      <noscript>
        <div class="term-output-box">
          <strong>[NO-JS MODE]</strong> Static filesystem view of <code>/home/geekonaut</code>:
        </div>
        <details class="fs-tree-details" open>
          <summary class="fs-tree-summary">📁 ~/blog/ ({{ collections.blog.length }})</summary>
          <ul class="fs-file-list" role="list">
            {% for post in collections.blog %}
              <li><a href="{{ post.url }}">📄 {{ post.fileSlug }}.md</a> <span class="text-muted">— {{ post.data.title }}</span></li>
            {% endfor %}
          </ul>
        </details>
        <details class="fs-tree-details" open>
          <summary class="fs-tree-summary">📁 ~/stuff/ ({{ collections.stuff.length }})</summary>
          <ul class="fs-file-list" role="list">
            {% for item in collections.stuff %}
              <li><a href="{{ item.url }}">📄 {{ item.fileSlug }}.md</a> <span class="text-muted">— {{ item.data.title }}</span></li>
            {% endfor %}
          </ul>
        </details>
        <details class="fs-tree-details" open>
          <summary class="fs-tree-summary">📁 ~/</summary>
          <ul class="fs-file-list" role="list">
            <li><a href="/">📄 welcome.md</a></li>
            <li><a href="/about/">📄 about.md</a></li>
          </ul>
        </details>
      </noscript>
    </div>

    <form id="terminal-form" class="terminal-input-row" autocomplete="off">
      <label id="terminal-prompt-label" for="terminal-input" class="terminal-prompt-label">geekonaut@zurich:~$</label>
      <input
        id="terminal-input"
        type="text"
        class="terminal-input"
        placeholder="Type help, ls, cd blog, cat about.md..."
        autocapitalize="off"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        autofocus
      >
      <button type="submit" class="pixel-btn">↵</button>
    </form>

    <div id="terminal-touchbar" class="terminal-touchbar" role="toolbar" aria-label="Quick terminal commands">
      <button type="button" class="touch-chip" data-touch-cmd="ls -la">ls</button>
      <button type="button" class="touch-chip" data-touch-cmd="tree">tree</button>
      <button type="button" class="touch-chip" data-touch-cmd="cd .. && ls">cd ..</button>
      <button type="button" class="touch-chip" data-touch-cmd="help">help</button>
      <button type="button" class="touch-chip" data-touch-cmd="clear">clear</button>
      <button type="button" class="touch-chip" data-touch-cmd="__TAB__">Tab ↹</button>
    </div>
  </div>
</section>

{% set aboutPage = collections.all | selectattr("url", "equalto", "/about/") | first %}
<script>
window.GEEKONAUT_FS = {
  about: {
    title: "About Martin Splitt (@g33konaut / AVGP)",
    date: "2026-11-16",
    size: {{ (aboutPage.templateContent | byteSize if aboutPage else "2.4 KB") | dump | safe }},
    content: {{ (aboutPage.templateContent | terminalText if aboutPage else site.author.bio) | dump | safe }}
  },
  blog: [
    {% for post in collections.blog %}
    {
      filename: {{ (post.fileSlug + ".md") | dump | safe }},
      title: {{ post.data.title | dump | safe }},
      date: {{ post.date | readableDate | dump | safe }},
      size: {{ post.templateContent | byteSize | dump | safe }},
      url: {{ post.url | dump | safe }},
      tags: {{ (post.data.tags | excludeTag("blog")) | dump | safe }},
      summary: {{ (post.data.summary or "") | dump | safe }},
      content: {{ post.templateContent | terminalText | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  stuff: [
    {% for item in collections.stuff %}
    {
      filename: {{ (item.fileSlug + ".md") | dump | safe }},
      title: {{ item.data.title | dump | safe }},
      category: {{ (item.data.category or "Project") | dump | safe }},
      date: {{ (item.data.year or "2026") | string | dump | safe }},
      size: {{ item.templateContent | byteSize | dump | safe }},
      url: {{ item.url | dump | safe }},
      externalUrl: {{ (item.data.externalUrl or "") | dump | safe }},
      repoUrl: {{ (item.data.repoUrl or "") | dump | safe }},
      summary: {{ (item.data.summary or "") | dump | safe }},
      content: {{ item.templateContent | terminalText | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
};
</script>
<script src="/assets/js/terminal.js" defer></script>
